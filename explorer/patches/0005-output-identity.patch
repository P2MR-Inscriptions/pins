--- a/packages/indexer/output-identity.test.ts
+++ b/packages/indexer/output-identity.test.ts
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: Apache-2.0
+import assert from "node:assert/strict";
+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { follow, type Rpc } from "./follow.ts";
+import { Store } from "./store.ts";
+import type { ChainBlock, ChainTx } from "./pins.ts";
+
+const SCRIPT = Uint8Array.of(0x51);
+const txidA = "aa".repeat(32);
+const txidB = "bb".repeat(32);
+const txidParent = "cc".repeat(32);
+
+function tx(txid: string, outputs: bigint[], input?: { prevTxid: string; prevVout: number; value: bigint }): ChainTx {
+  return {
+    txid,
+    inputs: input
+      ? [{ prevTxid: input.prevTxid, prevVout: input.prevVout, value: input.value }]
+      : [{ coinbase: true, value: 0n }],
+    outputs: outputs.map((value) => ({ value, script: SCRIPT })),
+  };
+}
+
+function block(height: number, txs: ChainTx[]): ChainBlock {
+  return { hash: `h${height}`, height, subsidy: 0n, txs };
+}
+
+function open(name: string): { store: Store; path: string } {
+  const path = join(mkdtempSync(join(tmpdir(), "pins-out-")), name);
+  return { store: new Store(path, { network: "regtest" }), path };
+}
+
+function heightOf(store: Store, txid: string, vout: number): number {
+  const row = (store as unknown as { outputRow(txid: string, vout: number): { height: number } | undefined }).outputRow(txid, vout);
+  assert.ok(row);
+  return Number(row.height);
+}
+
+test("a same-block spend is stored once, at the creating block", () => {
+  const { store } = open("same.sqlite");
+  store.commit(block(0, [
+    tx("coin", [50n]),
+    tx(txidA, [5n]),
+    tx(txidB, [5n], { prevTxid: txidA, prevVout: 0, value: 5n }),
+  ]));
+  assert.equal(store.outputValue(txidA, 0), 5n);
+  assert.equal(heightOf(store, txidA, 0), 0);
+  assert.equal(store.tip()?.height, 0);
+  store.close();
+});
+
+test("a restarted commit promotes a height -1 placeholder instead of inserting again", () => {
+  const { store, path } = open("resume.sqlite");
+  store.saveOutput(txidA, 0, 5n);
+  assert.equal(heightOf(store, txidA, 0), -1);
+  store.commit(block(0, [tx("coin", [50n]), tx(txidA, [5n])]));
+  assert.equal(heightOf(store, txidA, 0), 0);
+  store.close();
+  const again = new Store(path, { network: "regtest" });
+  assert.equal(again.tip()?.height, 0);
+  assert.equal(again.outputValue(txidA, 0), 5n);
+  assert.throws(() => again.commit(block(0, [tx("coin", [50n]), tx(txidA, [5n])])), /refusing block 0/);
+  assert.equal(again.tip()?.height, 0);
+  again.close();
+});
+
+test("a different stored value is not overwritten and does not commit the block", () => {
+  const { store } = open("mismatch.sqlite");
+  store.saveOutput(txidA, 0, 7n);
+  assert.throws(() => store.commit(block(0, [tx("coin", [50n]), tx(txidA, [5n])])), /different value/);
+  assert.equal(store.tip(), null);
+  assert.equal(store.outputValue(txidA, 0), 7n);
+  assert.equal(heightOf(store, txidA, 0), -1);
+  store.close();
+});
+
+test("two creators of one outpoint roll the block back", () => {
+  const { store } = open("dup.sqlite");
+  assert.throws(() => store.commit(block(0, [tx("coin", [50n]), tx(txidA, [5n]), tx(txidA, [5n])])), /created twice in block 0/);
+  assert.equal(store.tip(), null);
+  assert.equal(store.outputValue(txidA, 0), undefined);
+  store.close();
+});
+
+test("disconnect removes the block output and keeps a pre-activation parent", () => {
+  const { store } = open("undo.sqlite");
+  store.saveOutput(txidParent, 0, 9n);
+  store.commit(block(0, [
+    tx("coin", [50n]),
+    tx(txidB, [4n], { prevTxid: txidParent, prevVout: 0, value: 9n }),
+  ]));
+  assert.equal(heightOf(store, txidParent, 0), -1);
+  assert.equal(heightOf(store, txidB, 0), 0);
+  store.disconnect();
+  assert.equal(store.tip(), null);
+  assert.equal(store.outputValue(txidB, 0), undefined);
+  assert.equal(heightOf(store, txidParent, 0), -1);
+  store.close();
+});
+
+function le(value: number, bytes: number): string {
+  let out = "";
+  let rest = value;
+  for (let i = 0; i < bytes; i += 1) {
+    out += (rest & 0xff).toString(16).padStart(2, "0");
+    rest = Math.floor(rest / 256);
+  }
+  return out;
+}
+
+/** Minimal legacy transaction. An all-aa txid is unchanged when reversed. */
+function rawTx(input: { coinbase: true } | { txid: string; vout: number }, value: number): string {
+  const prev = "coinbase" in input ? "00".repeat(32) : input.txid;
+  const vout = "coinbase" in input ? "ffffffff" : le(input.vout, 4);
+  return `0100000001${prev}${vout}00ffffffff01${le(value, 8)}0000000000`;
+}
+
+test("follow promotes a same-block placeholder and does not fetch that parent", async () => {
+  const asked: string[] = [];
+  const hash = "11".repeat(32);
+  const rpc: Rpc = {
+    async call(method: string) {
+      if (method === "getblockchaininfo") return { chain: "regtest", blocks: 0, bestblockhash: hash };
+      if (method === "getblockcount") return 0;
+      if (method === "getblockhash") return hash;
+      if (method === "getrawtransaction") {
+        asked.push(method);
+        throw new Error("same-block parent must not be fetched");
+      }
+      if (method === "getblock") {
+        return {
+          hash,
+          height: 0,
+          tx: [
+            { txid: "33".repeat(32), hex: rawTx({ coinbase: true }, 50), vin: [{ coinbase: "00" }], vout: [] },
+            { txid: txidA, hex: rawTx({ coinbase: true }, 5), vin: [{ coinbase: "00" }], vout: [] },
+            { txid: txidB, hex: rawTx({ txid: txidA, vout: 0 }, 5), vin: [{ txid: txidA, vout: 0 }], vout: [] },
+          ],
+        };
+      }
+      throw new Error(method);
+    },
+  };
+  const { store } = open("follow.sqlite");
+  store.saveOutput(txidA, 0, 5n);
+  const synced = await follow(store, rpc, 0, "regtest");
+  assert.deepEqual(asked, []);
+  assert.equal(synced.height, 0);
+  assert.equal(heightOf(store, txidA, 0), 0);
+  const second = await follow(store, rpc, 0, "regtest");
+  assert.equal(second.height, 0);
+  assert.equal(heightOf(store, txidA, 0), 0);
+  store.close();
+});
+
+test("an outpoint already committed at an earlier height is not written again", () => {
+  const { store } = open("prior.sqlite");
+  store.commit(block(0, [tx("coin", [50n]), tx(txidA, [5n])]));
+  assert.throws(() => store.commit(block(1, [tx("c2", [50n]), tx(txidA, [5n])])), /already stored at height 0/);
+  assert.equal(store.tip()?.height, 0);
+  assert.equal(heightOf(store, txidA, 0), 0);
+  store.close();
+});
