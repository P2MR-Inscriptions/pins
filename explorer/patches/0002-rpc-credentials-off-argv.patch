@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: Apache-2.0
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { createServer, type Server } from "node:http";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { assertRpcEndpoint, credentialsFromEnvironment, curlRpcInvocation, redactSecrets } from "./rpc-auth.ts";
+
+const PASSWORD = "dummy-rpc-password";
+const USER = "dummy-rpc-user";
+
+test("curl invocation keeps credentials off argv", () => {
+  const call = curlRpcInvocation("http://127.0.0.1:8352/", USER, PASSWORD, "/tmp/body.json");
+  const visible = call.args.join(" ");
+  assert.equal(visible.includes(PASSWORD), false);
+  assert.equal(visible.includes(`${USER}:${PASSWORD}`), false);
+  assert.equal(call.args.includes("--config"), true);
+  assert.equal(call.args.includes("-"), true);
+  assert.equal(call.args[0], "-q");
+  assert.equal(call.args.includes("-u"), false);
+  assert.equal(call.args.includes("--proto-redir"), false);
+  assert.equal(call.args.includes("-all"), false);
+  assert.equal(call.args.includes("=-all"), false);
+  assert.ok(call.args.includes("--max-redirs") && call.args[call.args.indexOf("--max-redirs") + 1] === "0");
+  assert.equal(call.input, `user = "${USER}:${PASSWORD}"\n`);
+});
+
+function listen(handler: (req: import("node:http").IncomingMessage, res: import("node:http").ServerResponse) => void): Promise<Server> {
+  const server = createServer(handler);
+  return new Promise((resolve) => server.listen(0, "127.0.0.1", () => resolve(server)));
+}
+
+const curlBin = process.env.CURL_BIN || "/usr/bin/curl";
+
+function runCurl(args: string[], input: string, env: NodeJS.ProcessEnv = {}): Promise<{ status: number; stdout: string; stderr: string }> {
+  return new Promise((resolve, reject) => {
+    const child = spawn(curlBin, args, { stdio: ["pipe", "pipe", "pipe"], env: { ...process.env, ...env } });
+    let stdout = "";
+    let stderr = "";
+    child.stdout.setEncoding("utf8");
+    child.stderr.setEncoding("utf8");
+    child.stdout.on("data", (chunk) => { stdout += chunk; });
+    child.stderr.on("data", (chunk) => { stderr += chunk; });
+    child.on("error", reject);
+    child.on("close", (status) => resolve({ status: status ?? 1, stdout, stderr }));
+    child.stdin.end(input);
+  });
+}
+
+test("real curl sends the JSON body and stdin credentials, and refuses redirects", async () => {
+  const password = "dummy p@ss\"word";
+  const user = "dummy user";
+  let authOk = false;
+  let method = "";
+  let landed = 0;
+  const sink = await listen((_req, res) => { landed += 1; res.end("followed"); });
+  const rpc = await listen((req, res) => {
+    if (req.method === "GET") {
+      res.writeHead(302, { location: `http://127.0.0.1:${(sink.address() as { port: number }).port}/landed` });
+      res.end();
+      return;
+    }
+    const chunks: Buffer[] = [];
+    req.on("data", (chunk) => chunks.push(chunk));
+    req.on("end", () => {
+      const body = JSON.parse(Buffer.concat(chunks).toString("utf8")) as { method?: string };
+      method = body.method ?? "";
+      authOk = req.headers.authorization === `Basic ${Buffer.from(`${user}:${password}`).toString("base64")}`;
+      res.writeHead(200, { "content-type": "application/json" });
+      res.end(JSON.stringify({ result: { chain: "regtest", blocks: 0, bestblockhash: "aa".repeat(32) }, error: null }));
+    });
+  });
+  const dir = mkdtempSync(join(tmpdir(), "pins curl "));
+  const bodyFile = join(dir, "body.json");
+  writeFileSync(bodyFile, JSON.stringify({ jsonrpc: "1.0", id: "indexer", method: "getblockchaininfo", params: [] }));
+  const url = `http://127.0.0.1:${(rpc.address() as { port: number }).port}/`;
+  const call = curlRpcInvocation(url, user, password, bodyFile, 5);
+  try {
+    const run = await runCurl(call.args, call.input);
+    assert.equal(run.status, 0, run.stderr);
+    assert.equal(run.stderr.includes(password), false);
+    assert.equal(run.stderr.includes("badly used"), false);
+    assert.equal(call.args.join("\0").includes(password), false);
+    assert.equal(authOk, true);
+    assert.equal(method, "getblockchaininfo");
+    const getArgs = ["-q", "-L", ...call.args.filter((arg) => arg !== "-q" && arg !== "--data-binary" && !arg.startsWith("@"))];
+    assert.equal(getArgs[0], "-q");
+    assert.ok(getArgs.includes("--max-redirs") && getArgs[getArgs.indexOf("--max-redirs") + 1] === "0");
+    const redirected = await runCurl(getArgs, call.input);
+    assert.notEqual(redirected.status, 0);
+    assert.equal(/unrecognized protocol|badly used/i.test(redirected.stderr), false);
+    assert.equal(redirected.stderr.includes(password), false);
+    assert.equal(landed, 0);
+    const home = mkdtempSync(join(tmpdir(), "curlhome "));
+    writeFileSync(join(home, ".curlrc"), "location\nmax-redirs = 10\n");
+    const beforeRc = landed;
+    const viaRc = await runCurl(call.args.filter((arg) => arg !== "--data-binary" && !arg.startsWith("@")), call.input, { CURL_HOME: home, HOME: home });
+    assert.equal(/unrecognized protocol|badly used/i.test(viaRc.stderr), false);
+    assert.equal(viaRc.stderr.includes(password), false);
+    assert.equal(landed, beforeRc);
+    const stall = await listen(() => undefined);
+    try {
+      const slow = curlRpcInvocation(`http://127.0.0.1:${(stall.address() as { port: number }).port}/`, user, password, bodyFile, 1);
+      const timed = await runCurl(slow.args, slow.input);
+      assert.notEqual(timed.status, 0);
+      assert.equal(timed.stderr.includes(password), false);
+      assert.equal(timed.stderr.includes("badly used"), false);
+      assert.match(timed.stderr, /timed out|Timeout|timeout/i);
+    } finally {
+      stall.close();
+    }
+  } finally {
+    rpc.close();
+    sink.close();
+  }
+});
+
+test("credential URL and command-line flags are refused", () => {
+  assert.throws(() => assertRpcEndpoint("http://alice:secret@127.0.0.1:8352/"), /must not contain credentials/);
+  assert.throws(() => curlRpcInvocation("http://alice:secret@127.0.0.1/", USER, PASSWORD, "body.json"), /must not contain credentials/);
+  assert.throws(() => credentialsFromEnvironment({ QBIT_RPC_USER: USER, QBIT_RPC_PASSWORD: PASSWORD }, ["--rpc-password", PASSWORD]), /command line/);
+  assert.throws(() => credentialsFromEnvironment({}, ["node", "indexer"]), /environment/);
+});
+
+test("environment credentials are accepted and redacted", () => {
+  const got = credentialsFromEnvironment({ QBIT_RPC_USER: USER, QBIT_RPC_PASSWORD: PASSWORD }, ["node", "indexer-run.ts"]);
+  assert.equal(got.user, USER);
+  assert.equal(got.password, PASSWORD);
+  const redacted = redactSecrets(`curl failed for http://alice:${PASSWORD}@127.0.0.1/ ${PASSWORD}`, [USER, PASSWORD]);
+  assert.equal(redacted.includes(PASSWORD), false);
+  assert.match(redacted, /\[redacted\]@/);
+});
