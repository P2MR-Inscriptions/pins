+// SPDX-License-Identifier: Apache-2.0
+
+/**
+ * RPC credentials stay off process arguments.
+ * Curl reads `user = "..."` from stdin (`--config -`). Callers take the user
+ * and password from the environment, never from `--rpc-user` or `--rpc-password`.
+ */
+
+export function assertRpcEndpoint(url: string): void {
+  let parsed: URL;
+  try {
+    parsed = new URL(url);
+  } catch {
+    throw new Error("RPC URL is not valid");
+  }
+  if (parsed.username || parsed.password) throw new Error("RPC URL must not contain credentials");
+  if (parsed.protocol !== "http:" && parsed.protocol !== "https:") throw new Error("RPC URL must be http or https");
+}
+
+export function curlConfigQuoted(value: string): string {
+  if (/[\r\n\0]/.test(value)) throw new Error("RPC credential must be a single line");
+  return `"${value.replace(/\\/g, "\\\\").replace(/"/g, '\\"')}"`;
+}
+
+/**
+ * Arguments contain no user or password. The password is only in `input`.
+ * Curl 8.18 treats a leading `=` in a protocol list as "permit only", so
+ * `--proto-redir =-all` is the unknown protocol `-all` and is "badly used".
+ * A bare `-all` is also "badly used" because the value starts with a dash.
+ * An empty redirect protocol list is rejected too. Redirects are therefore
+ * refused with `--max-redirs 0`, and `-q` is first so a curlrc cannot enable
+ * `--location` or raise that limit.
+ */
+export function curlRpcInvocation(url: string, user: string, password: string, bodyFile: string, timeoutSeconds = 180): { args: string[]; input: string } {
+  assertRpcEndpoint(url);
+  if (!Number.isFinite(timeoutSeconds) || timeoutSeconds <= 0) throw new Error("curl timeout must be positive");
+  const input = `user = ${curlConfigQuoted(`${user}:${password}`)}\n`;
+  const args = ["-q", "-sS", "--max-redirs", "0", "-m", String(timeoutSeconds), "--config", "-", "-H", "content-type: application/json", "--data-binary", `@${bodyFile}`, url];
+  if (args[0] !== "-q") throw new Error("curl must ignore curlrc");
+  if (args.includes("--proto-redir") || args.includes("-all") || args.includes("=-all")) throw new Error("refusing a curl --proto-redir form this indexer does not use");
+  if (args.join("\0").includes(`${user}:${password}`)) throw new Error("refusing to put RPC credentials on the curl command line");
+  return { args, input };
+}
+
+export function redactSecrets(text: string, secrets: readonly string[]): string {
+  let out = text;
+  const unique = [...secrets].filter((secret) => secret.length > 0).sort((a, b) => b.length - a.length);
+  for (const secret of unique) out = out.split(secret).join("[redacted]");
+  out = out.replace(/([a-z][a-z0-9+.-]*:\/\/)[^\s/@]*:[^\s/@]*@/gi, "$1[redacted]@");
+  return out.slice(0, 240);
+}
+
+const CREDENTIAL_ARG = /^(?:--rpc-password|--rpc-user)(?:=|$)/;
+
+export function credentialsFromEnvironment(env: NodeJS.ProcessEnv, argv: readonly string[]): { user: string; password: string } {
+  if (argv.some((arg) => CREDENTIAL_ARG.test(arg))) {
+    throw new Error("refusing RPC credentials on the command line; set QBIT_RPC_USER and QBIT_RPC_PASSWORD in the environment");
+  }
+  const user = env.QBIT_RPC_USER ?? "";
+  const password = env.QBIT_RPC_PASSWORD ?? "";
+  if (!user || !password) throw new Error("set QBIT_RPC_USER and QBIT_RPC_PASSWORD in the environment, not on the command line");
+  if (/[\r\n\0]/.test(user) || /[\r\n\0]/.test(password)) throw new Error("RPC credentials must be a single line");
+  return { user, password };
+}
