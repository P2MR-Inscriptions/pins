HOST=127.0.0.1
PORT=8080
INDEXER_URL=http://127.0.0.1:8787
POLL_MS=5000
# Manifest of the one collection to feature. This line names the FlatBits example, a real public
# collection, as a starting point. Replace it with your own manifest, or leave it empty to feature none.
MANIFEST=config/examples/flatbits.json
QBIT_RPC_URL=
QBIT_RPC_USER=
QBIT_RPC_PASSWORD=
QBIT_CONF=
EXPLORER_URL=
CONTENT_MAX_BYTES=2000000
RATE_PER_MINUTE=240
MAX_CONCURRENCY=8
