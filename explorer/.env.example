# Address the explorer listens on. It listens on loopback only; any other value is refused.
HOST=127.0.0.1
PORT=8080
# The indexer the explorer reads. It must be on loopback. If you change INDEXER_PORT below, change this too.
INDEXER_URL=http://127.0.0.1:8787
# Gap in milliseconds between reads of the indexer (1000 to 3600000).
POLL_MS=5000
# Manifest of the one collection to feature. This line names the Flatbits example, a real public
# collection, as a starting point. Replace it with your own manifest, or leave it empty to feature none.
MANIFEST=config/examples/flatbits.json

# Login to the node's RPC, one kind only.
# The URL is required. A cookie login needs a URL on this machine.
QBIT_RPC_URL=
# 1. A user and a password:
QBIT_RPC_USER=
QBIT_RPC_PASSWORD=
# 2. The node's cookie file, read for every call, so a node restart needs no restart here:
QBIT_RPC_COOKIE_FILE=
# 3. The node's data directory. The cookie of PINS_NETWORK in it is used (a node on mainnet keeps it in the
#    directory itself, one on regtest or testnet4 in a subdirectory of that name):
QBIT_RPC_DATADIR=
# Or a qbit.conf with rpcuser and rpcpassword (read as text), which also gives the URL when QBIT_RPC_URL is empty:
QBIT_CONF=

# Network of the node: mainnet, testnet4 or regtest. Default mainnet. It starts the indexer on that network
# (`npm run indexer`) and picks the cookie under QBIT_RPC_DATADIR.
PINS_NETWORK=mainnet
# Mainnet cookie example. In this file the path must be absolute; a leading ~ is not expanded:
# QBIT_RPC_URL=http://127.0.0.1:8352/
# QBIT_RPC_DATADIR=/home/operator/.qbit
# Port of the indexer that `npm run indexer` starts. Default 8787.
INDEXER_PORT=8787

# A link target for "open in an explorer" (an http or https URL). Empty: none.
EXPLORER_URL=
# Largest P2MR Inscription body the content route serves, in bytes (1 to 32000000).
CONTENT_MAX_BYTES=2000000
# Requests per minute per client (1 to 100000), and requests handled at once (1 to 1000).
# A gallery page loads 104 images at once (PAGE_SIZE in public/app.js). Under HTTP/2 those
# can all be in flight together, so the default concurrency is 128 (one page plus headroom).
# 2000 requests per minute covers several page turns and retries without a 429, while a
# client that crawls far faster still hits the cap.
RATE_PER_MINUTE=2000
MAX_CONCURRENCY=128
# Most P2MR Inscriptions the explorer holds in memory from the indexer (1 to 5000000). A bigger index is refused.
MAX_INSCRIPTIONS=200000
# Host header names to answer besides loopback, comma separated. Empty: loopback only.
TRUSTED_HOSTS=
# Set to 1 behind a reverse proxy on the same machine: the explorer then reads X-Forwarded-Host and rate-limits
# by the last X-Forwarded-For address.
TRUST_PROXY=
